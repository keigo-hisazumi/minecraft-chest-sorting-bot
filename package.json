    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keigo-hisazumi/minecraft-chest-sorting-bot.git"
  },
  "author": "keigo-hisazumi",
  "license": "MIT",
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.16.0",
    "globals": "^17.14.0"
  }
}
