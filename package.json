{
  "name": "minecraft-chest-sorting-bot",
  "version": "0.1.0",
  "private": true,
  "description": "指定したチェストのアイテムを周囲のチェストへ振り分ける Minecraft BOT",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
